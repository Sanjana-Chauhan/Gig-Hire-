# Copy to .env and adjust. .env is never committed.
# Every value here has a working default in config/settings/base.py, so the
# project runs without this file; it exists for overrides.

# Required in production. The committed default is a placeholder, not a secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# base.py defaults to False; config/settings/dev.py defaults to True.
DJANGO_DEBUG=True

# Comma-separated. Must be pinned to real hostnames in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Omit to use the local SQLite file. Set to switch databases without code
# changes, e.g. postgres://user:password@localhost:5432/gighire
# DATABASE_URL=

# Filename of the SQLite database, relative to the repository root.
SQLITE_NAME=db.sqlite3

# Default number of items per page for list endpoints.
API_PAGE_SIZE=20

# DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO
